let currentIndex = 0;

function renderNav(){
  const nav = document.getElementById('navlist');
  nav.innerHTML = modules.map((m,i)=>`
    <li><button data-idx="${i}" class="${i===currentIndex?'active':''}">
      <span class="num">${String(i+1).padStart(2,'0')}</span><span>${m.title}</span>
    </button></li>
  `).join('');
  nav.querySelectorAll('button').forEach(btn=>{
    btn.addEventListener('click', ()=> goTo(parseInt(btn.dataset.idx)));
  });
}

function renderMain(){
  const main = document.getElementById('main');
  main.innerHTML = modules.map((m,i)=>`
    <section class="module ${i===currentIndex?'active':''}" id="mod-${m.id}">
      <div class="kicker">Tópico ${String(i+1).padStart(2,'0')} de ${modules.length} · ${m.exercises.length} exercícios</div>
      <h2 class="mtitle">${m.title}</h2>
      <p class="lede">${m.lede}</p>
      <div class="exercises">
        ${m.exercises.map((ex,j)=>`
          <div class="ex">
            <div class="exq">${j+1}. ${ex.q}</div>
            <details><summary>Ver solução</summary><pre>${ex.a}</pre></details>
          </div>
        `).join('')}
      </div>
      <div class="modnav">
        <button data-nav="prev" ${i===0?'disabled':''}>&larr; Tópico anterior</button>
        <button data-nav="next" ${i===modules.length-1?'disabled':''}>Próximo tópico &rarr;</button>
      </div>
    </section>
  `).join('');

  main.querySelectorAll('[data-nav]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(btn.dataset.nav==='prev') goTo(currentIndex-1);
      else goTo(currentIndex+1);
    });
  });
}

function goTo(idx){
  if(idx<0 || idx>=modules.length) return;
  currentIndex = idx;
  renderNav();
  document.querySelectorAll('.module').forEach((el,i)=>{
    el.classList.toggle('active', i===currentIndex);
  });
  window.scrollTo({top:0, behavior:'smooth'});
}

renderNav();
renderMain();
</script>
