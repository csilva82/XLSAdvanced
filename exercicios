
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Exercícios — VBA Avançado para Excel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b2420;
    --paper:#f6f4ec;
    --paper-2:#efece1;
    --line:#d9d4c4;
    --green-dk:#123f28;
    --green:#1a6b41;
    --green-lt:#3e9a6c;
    --amber:#b4762c;
    --code-bg:#12181f;
    --code-text:#d7dce3;
    --code-key:#7fb7e8;
    --code-str:#d0a35c;
    --code-com:#5f7167;
    --sidebar-bg:#0d1310;
    --sidebar-text:#c9d2c9;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.6;
  }
  .app{
    display:grid;
    grid-template-columns:280px 1fr;
    min-height:100vh;
  }
  .sidebar{
    background:var(--sidebar-bg);
    color:var(--sidebar-text);
    padding:28px 0 40px;
    position:sticky;
    top:0;
    height:100vh;
    overflow-y:auto;
  }
  .brand{
    padding:0 24px 20px;
    border-bottom:1px solid rgba(255,255,255,.08);
    margin-bottom:14px;
  }
  .brand .tag{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    color:var(--green-lt);
    letter-spacing:.04em;
  }
  .brand h1{
    font-family:'Spectral',serif;
    font-size:20px;
    font-weight:600;
    margin:6px 0 0;
    color:#fff;
    line-height:1.25;
  }
  .nav-group-label{
    font-family:'JetBrains Mono',monospace;
    font-size:10.5px;
    color:#6b776d;
    padding:14px 24px 6px;
  }
  .navlist{list-style:none;margin:0;padding:0;}
  .navlist li{margin:0;}
  .navlist button{
    all:unset;
    display:flex;
    gap:10px;
    align-items:baseline;
    width:100%;
    padding:9px 24px;
    cursor:pointer;
    font-size:13.5px;
    color:var(--sidebar-text);
    border-left:3px solid transparent;
  }
  .navlist button .num{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    color:#5c6b5e;
    min-width:20px;
  }
  .navlist button:hover{background:rgba(255,255,255,.05); color:#fff;}
  .navlist button.active{
    background:rgba(62,154,108,.14);
    border-left-color:var(--green-lt);
    color:#fff;
  }
  .navlist button.active .num{color:var(--green-lt);}

  main{
    padding:56px 64px 120px;
    max-width:860px;
  }
  .module{display:none;}
  .module.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}

  .kicker{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    color:var(--green);
    margin-bottom:10px;
  }
  h2.mtitle{
    font-family:'Spectral',serif;
    font-size:34px;
    font-weight:700;
    margin:0 0 14px;
    color:var(--green-dk);
    max-width:24ch;
  }
  .lede{
    font-size:16px;
    color:#3a453e;
    max-width:68ch;
    margin-bottom:8px;
  }
  code.inline{
    font-family:'JetBrains Mono',monospace;
    background:var(--paper-2);
    border:1px solid var(--line);
    padding:1px 6px;
    border-radius:3px;
    font-size:.9em;
  }
  pre{
    background:var(--code-bg);
    color:var(--code-text);
    padding:18px 20px;
    border-radius:6px;
    overflow-x:auto;
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;
    line-height:1.6;
    margin:8px 0 0;
    border:1px solid #232c25;
  }
  pre .kw{color:var(--code-key);}
  pre .str{color:var(--code-str);}
  pre .com{color:var(--code-com); font-style:italic;}

  .exercises{
    margin-top:30px;
    padding-top:10px;
  }
  .ex{
    background:#fff;
    border:1px solid var(--line);
    border-radius:6px;
    padding:18px 20px;
    margin-bottom:14px;
  }
  .ex .exq{font-weight:600; margin-bottom:8px; font-size:14.5px;}
  .ex details{margin-top:6px;}
  .ex summary{
    cursor:pointer;
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    color:var(--green);
    outline:none;
    user-select:none;
  }
  .ex details[open] summary{margin-bottom:10px;}

  .modnav{
    display:flex;
    justify-content:space-between;
    margin-top:44px;
    padding-top:20px;
    border-top:1px solid var(--line);
  }
  .modnav button{
    all:unset;
    cursor:pointer;
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;
    color:var(--green-dk);
    padding:8px 0;
  }
  .modnav button:hover{color:var(--green-lt);}
  .modnav button:disabled{color:#b9b2a0; cursor:default;}

  @media (max-width:820px){
    .app{grid-template-columns:1fr;}
    .sidebar{position:relative; height:auto;}
    main{padding:36px 22px 100px;}
    h2.mtitle{font-size:26px;}
  }
</style>
</head>
<body>
<div class="app">
  <nav class="sidebar">
    <div class="brand">
      <div class="tag">Projeto1 (VBAProject) · Lista de Exercícios</div>
      <h1>Exercícios<br>VBA Avançado</h1>
    </div>
    <div class="nav-group-label">Tópicos do curso</div>
    <ul class="navlist" id="navlist"></ul>
  </nav>
  <main id="main"></main>
</div>

<script>
const modules = [
{
  id:"ambiente",
  title:"Ambiente VBA (VBE)",
  lede:"Exercícios sobre o Editor VBA, janelas do VBE, salvamento em .xlsm e comandos básicos.",
  exercises:[
    {q:"Crie uma macro chamada AbrirBoasVindas que exiba na Janela Imediata a mensagem 'Curso iniciado' usando Debug.Print.",
     a:`<span class="kw">Sub</span> AbrirBoasVindas()
    Debug.Print <span class="str">"Curso iniciado"</span>
<span class="kw">End Sub</span>`},
    {q:"Escreva uma macro que exiba em uma MsgBox a versão do Excel em uso (Application.Version) e o nome do usuário (Application.UserName).",
     a:`<span class="kw">Sub</span> MostrarInfoAplicativo()
    MsgBox <span class="str">"Versão: "</span> & Application.Version & vbCrLf & _
           <span class="str">"Usuário: "</span> & Application.UserName
<span class="kw">End Sub</span>`},
    {q:"Escreva uma macro que conte quantos componentes (módulos, planilhas, formulários) existem no projeto VBA atual, usando ThisWorkbook.VBProject.VBComponents.Count.",
     a:`<span class="com">' Requer "Confiar no acesso ao modelo de objeto de projetos do VBA"
' habilitado em Opções → Central de Confiabilidade</span>
<span class="kw">Sub</span> ContarComponentes()
    MsgBox <span class="str">"Total de componentes no projeto: "</span> & _
           ThisWorkbook.VBProject.VBComponents.Count
<span class="kw">End Sub</span>`},
    {q:"Sem criar uma macro, use a Janela Imediata (Ctrl+G) para calcular e imprimir o resultado de 2 elevado a 10.",
     a:`? 2^10
<span class="com">' resultado impresso diretamente na Janela Imediata: 1024</span>`},
    {q:"Escreva um código que salve a pasta de trabalho atual como 'MeuProjeto.xlsm', garantindo que o formato habilitado para macro seja usado.",
     a:`<span class="kw">Sub</span> SalvarComoXlsm()
    ThisWorkbook.SaveAs Filename:=<span class="str">"C:\\Dados\\MeuProjeto.xlsm"</span>, _
        FileFormat:=xlOpenXMLWorkbookMacroEnabled
<span class="kw">End Sub</span>`}
  ]
},
{
  id:"objetos",
  title:"Objetos, Métodos e Propriedades",
  lede:"Exercícios sobre a hierarquia de objetos do Excel e a diferença entre propriedades e métodos.",
  exercises:[
    {q:"Insira 'Total:' na célula A1 e o valor 500 na célula B1, aplicando itálico à célula A1 (propriedade Font.Italic).",
     a:`<span class="kw">Sub</span> FormatarTitulo()
    Range(<span class="str">"A1"</span>).Value = <span class="str">"Total:"</span>
    Range(<span class="str">"A1"</span>).Font.Italic = <span class="kw">True</span>
    Range(<span class="str">"B1"</span>).Value = 500
<span class="kw">End Sub</span>`},
    {q:"Escreva um código que use um método (não propriedade) para apagar o conteúdo e a formatação da célula C1, sem removê-la da planilha.",
     a:`<span class="kw">Sub</span> LimparCelula()
    Range(<span class="str">"C1"</span>).Clear <span class="com">' Clear é um método, não uma propriedade</span>
<span class="kw">End Sub</span>`},
    {q:"Crie uma macro que adicione uma nova planilha chamada 'Resumo' após a última planilha existente, usando o método Worksheets.Add.",
     a:`<span class="kw">Sub</span> AdicionarResumo()
    <span class="kw">Dim</span> nova <span class="kw">As</span> Worksheet
    <span class="kw">Set</span> nova = Worksheets.Add(After:=Worksheets(Worksheets.Count))
    nova.Name = <span class="str">"Resumo"</span>
<span class="kw">End Sub</span>`},
    {q:"Altere a cor de fundo da célula D1 para azul claro usando a propriedade Interior.Color, e identifique em comentário qual parte do código é objeto, propriedade e valor.",
     a:`<span class="kw">Sub</span> PintarCelula()
    <span class="com">' Range("D1")      → objeto
' .Interior       → propriedade que retorna outro objeto (Interior)
' .Color          → propriedade do objeto Interior
' RGB(...)        → valor atribuído</span>
    Range(<span class="str">"D1"</span>).Interior.Color = RGB(198, 224, 255)
<span class="kw">End Sub</span>`},
    {q:"Usando a hierarquia Application → Workbook → Worksheet → Range, escreva um código que leia explicitamente o valor da célula A1 da planilha 'Plan1' da pasta de trabalho 'Vendas.xlsx' já aberta, mostrando-o em uma MsgBox.",
     a:`<span class="kw">Sub</span> LerValorExplicito()
    <span class="kw">Dim</span> valor <span class="kw">As</span> Variant
    valor = Application.Workbooks(<span class="str">"Vendas.xlsx"</span>) _
        .Worksheets(<span class="str">"Plan1"</span>).Range(<span class="str">"A1"</span>).Value
    MsgBox <span class="str">"Valor lido: "</span> & valor
<span class="kw">End Sub</span>`}
  ]
},
{
  id:"estruturas",
  title:"Estruturas, Operadores Lógicos e Instruções",
  lede:"Exercícios sobre If/Select Case, operadores lógicos e laços de repetição.",
  exercises:[
    {q:"Crie uma macro que use Select Case para classificar o número da célula A1 como 'Positivo', 'Negativo' ou 'Zero', escrevendo o resultado em B1.",
     a:`<span class="kw">Sub</span> ClassificarNumero()
    <span class="kw">Select Case</span> Range(<span class="str">"A1"</span>).Value
        <span class="kw">Case Is</span> > 0: Range(<span class="str">"B1"</span>).Value = <span class="str">"Positivo"</span>
        <span class="kw">Case Is</span> < 0: Range(<span class="str">"B1"</span>).Value = <span class="str">"Negativo"</span>
        <span class="kw">Case Else</span>: Range(<span class="str">"B1"</span>).Value = <span class="str">"Zero"</span>
    <span class="kw">End Select</span>
<span class="kw">End Sub</span>`},
    {q:"Escreva um loop For...Next que preencha as células A1:A10 com os quadrados dos números de 1 a 10.",
     a:`<span class="kw">Sub</span> PreencherQuadrados()
    <span class="kw">Dim</span> i <span class="kw">As</span> Integer
    <span class="kw">For</span> i = 1 <span class="kw">To</span> 10
        Cells(i, 1).Value = i ^ 2
    <span class="kw">Next</span> i
<span class="kw">End Sub</span>`},
    {q:"Utilize For Each para percorrer o intervalo B1:B10 e contar quantas células têm valor maior que 50, mostrando o total em uma MsgBox.",
     a:`<span class="kw">Sub</span> ContarMaioresQue50()
    <span class="kw">Dim</span> cel <span class="kw">As</span> Range, cont <span class="kw">As</span> Integer
    <span class="kw">For Each</span> cel <span class="kw">In</span> Range(<span class="str">"B1:B10"</span>)
        <span class="kw">If</span> cel.Value > 50 <span class="kw">Then</span> cont = cont + 1
    <span class="kw">Next</span> cel
    MsgBox <span class="str">"Total acima de 50: "</span> & cont
<span class="kw">End Sub</span>`},
    {q:"Usando operadores lógicos (And, Or), verifique se um funcionário pode receber bônus: idade (A1) >= 18 E (vendas (B1) >= 1000 OU tempo de empresa (C1) >= 5).",
     a:`<span class="kw">Sub</span> VerificarBonus()
    <span class="kw">If</span> Range(<span class="str">"A1"</span>).Value >= 18 <span class="kw">And</span> _
       (Range(<span class="str">"B1"</span>).Value >= 1000 <span class="kw">Or</span> Range(<span class="str">"C1"</span>).Value >= 5) <span class="kw">Then</span>
        MsgBox <span class="str">"Funcionário elegível ao bônus."</span>
    <span class="kw">Else</span>
        MsgBox <span class="str">"Funcionário não elegível."</span>
    <span class="kw">End If</span>
<span class="kw">End Sub</span>`},
    {q:"Utilize Do Until para preencher a coluna A com números sequenciais de 1 até o valor digitado pelo usuário em um InputBox.",
     a:`<span class="kw">Sub</span> PreencherAteValor()
    <span class="kw">Dim</span> limite <span class="kw">As</span> Long, lin <span class="kw">As</span> Long
    limite = CLng(InputBox(<span class="str">"Digite o número final:"</span>))
    lin = 1
    <span class="kw">Do Until</span> lin > limite
        Cells(lin, 1).Value = lin
        lin = lin + 1
    <span class="kw">Loop</span>
<span class="kw">End Sub</span>`}
  ]
},
{
  id:"erros",
  title:"Estruturas de Tratamento de Erros",
  lede:"Exercícios sobre On Error, o objeto Err e blocos estruturados de tratamento.",
  exercises:[
    {q:"Escreva uma macro que divida o valor de A1 por B1, tratando com On Error GoTo tanto o erro de divisão por zero quanto o de tipo inválido.",
     a:`<span class="kw">Sub</span> DividirComTratamento()
    <span class="kw">On Error GoTo</span> TratarErro
    <span class="kw">Dim</span> resultado <span class="kw">As</span> Double
    resultado = Range(<span class="str">"A1"</span>).Value / Range(<span class="str">"B1"</span>).Value
    Range(<span class="str">"C1"</span>).Value = resultado
    <span class="kw">Exit Sub</span>
TratarErro:
    MsgBox <span class="str">"Erro "</span> & Err.Number & <span class="str">": "</span> & Err.Description
<span class="kw">End Sub</span>`},
    {q:"Use On Error Resume Next para verificar, de forma silenciosa, se a planilha 'Backup' existe na pasta de trabalho, avisando o usuário caso não exista.",
     a:`<span class="kw">Sub</span> VerificarPlanilha()
    <span class="kw">On Error Resume Next</span>
    Worksheets(<span class="str">"Backup"</span>).Activate
    <span class="kw">If</span> Err.Number <> 0 <span class="kw">Then</span>
        MsgBox <span class="str">"A planilha 'Backup' não existe."</span>
        Err.Clear
    <span class="kw">End If</span>
    <span class="kw">On Error GoTo</span> 0
<span class="kw">End Sub</span>`},
    {q:"Crie uma Function ValidarIdade que use Err.Raise para gerar um erro personalizado quando receber um valor de idade negativo.",
     a:`<span class="kw">Function</span> ValidarIdade(idade <span class="kw">As</span> Integer) <span class="kw">As</span> Boolean
    <span class="kw">If</span> idade < 0 <span class="kw">Then</span>
        Err.Raise vbObjectError + 514, , <span class="str">"Idade não pode ser negativa."</span>
    <span class="kw">End If</span>
    ValidarIdade = <span class="kw">True</span>
<span class="kw">End Function</span>`},
    {q:"Escreva um bloco estruturado que desative Application.ScreenUpdating e Application.Calculation manual no início, e restaure ambos no bloco de saída mesmo se ocorrer erro.",
     a:`<span class="kw">Sub</span> ProcessoSeguro()
    <span class="kw">On Error GoTo</span> TratarErro
    Application.ScreenUpdating = <span class="kw">False</span>
    Application.Calculation = xlCalculationManual

    <span class="com">' ... código principal ...</span>

Saida:
    Application.ScreenUpdating = <span class="kw">True</span>
    Application.Calculation = xlCalculationAutomatic
    <span class="kw">Exit Sub</span>
TratarErro:
    MsgBox <span class="str">"Falha: "</span> & Err.Description, vbCritical
    <span class="kw">Resume</span> Saida
<span class="kw">End Sub</span>`},
    {q:"Crie uma macro que tente copiar o intervalo 'A1:A10' de uma planilha chamada 'Origem' (que não existe) para 'Plan1', tratando e exibindo o número e a descrição do erro gerado.",
     a:`<span class="kw">Sub</span> CopiarComTratamento()
    <span class="kw">On Error GoTo</span> TratarErro
    Worksheets(<span class="str">"Origem"</span>).Range(<span class="str">"A1:A10"</span>).Copy _
        Worksheets(<span class="str">"Plan1"</span>).Range(<span class="str">"A1"</span>)
    <span class="kw">Exit Sub</span>
TratarErro:
    MsgBox <span class="str">"Erro "</span> & Err.Number & <span class="str">" - "</span> & Err.Description
<span class="kw">End Sub</span>`}
  ]
},
{
  id:"eventos",
  title:"Eventos e Instruções",
  lede:"Exercícios sobre eventos de planilha e de pasta de trabalho.",
  exercises:[
    {q:"Crie um evento Worksheet_SelectionChange que destaque em amarelo a linha inteira da célula selecionada, removendo o destaque anterior.",
     a:`<span class="kw">Private Sub</span> Worksheet_SelectionChange(<span class="kw">ByVal</span> Target <span class="kw">As</span> Range)
    Cells.Interior.ColorIndex = xlNone
    Target.EntireRow.Interior.Color = RGB(255, 255, 153)
<span class="kw">End Sub</span>`},
    {q:"Crie um evento Workbook_BeforeSave que impeça o salvamento se a célula 'A1' da planilha 'Dados' estiver vazia, exibindo um aviso.",
     a:`<span class="kw">Private Sub</span> Workbook_BeforeSave(<span class="kw">ByVal</span> SaveAsUI <span class="kw">As</span> Boolean, Cancel <span class="kw">As</span> Boolean)
    <span class="kw">If</span> Worksheets(<span class="str">"Dados"</span>).Range(<span class="str">"A1"</span>).Value = <span class="str">""</span> <span class="kw">Then</span>
        MsgBox <span class="str">"Preencha a célula A1 antes de salvar."</span>, vbExclamation
        Cancel = <span class="kw">True</span>
    <span class="kw">End If</span>
<span class="kw">End Sub</span>`},
    {q:"Crie um evento Worksheet_Activate que exiba uma mensagem de boas-vindas toda vez que a planilha 'Dashboard' for ativada, mostrando a data atual.",
     a:`<span class="com">' Código no módulo da planilha Dashboard</span>
<span class="kw">Private Sub</span> Worksheet_Activate()
    MsgBox <span class="str">"Bem-vindo ao Dashboard! Hoje é "</span> & Format(Date, <span class="str">"dd/mm/yyyy"</span>)
<span class="kw">End Sub</span>`},
    {q:"No módulo ThisWorkbook, crie um evento Workbook_BeforeClose que cancele o fechamento se houver alterações não salvas e o usuário optar por 'Não' ao ser perguntado se deseja fechar mesmo assim.",
     a:`<span class="kw">Private Sub</span> Workbook_BeforeClose(Cancel <span class="kw">As</span> Boolean)
    <span class="kw">If Not</span> Me.Saved <span class="kw">Then</span>
        <span class="kw">If</span> MsgBox(<span class="str">"Há alterações não salvas. Deseja fechar mesmo assim?"</span>, vbYesNo) = vbNo <span class="kw">Then</span>
            Cancel = <span class="kw">True</span>
        <span class="kw">End If</span>
    <span class="kw">End If</span>
<span class="kw">End Sub</span>`},
    {q:"Crie um evento Worksheet_Change que converta automaticamente para maiúsculas qualquer texto digitado na coluna A, evitando um loop infinito de eventos.",
     a:`<span class="kw">Private Sub</span> Worksheet_Change(<span class="kw">ByVal</span> Target <span class="kw">As</span> Range)
    <span class="kw">If Not</span> Intersect(Target, Columns(<span class="str">"A"</span>)) <span class="kw">Is Nothing Then</span>
        Application.EnableEvents = <span class="kw">False</span>
        Target.Value = UCase(Target.Value)
        Application.EnableEvents = <span class="kw">True</span>
    <span class="kw">End If</span>
<span class="kw">End Sub</span>`}
  ]
},
{
  id:"classes",
  title:"Módulos de Classe",
  lede:"Exercícios sobre criação de classes, encapsulamento e uso de Property Get/Let/Set.",
  exercises:[
    {q:"Crie uma classe clsCliente com propriedades Nome, Email e Telefone, e um método ExibirDados que mostre tudo em uma MsgBox.",
     a:`<span class="com">' --- clsCliente ---</span>
<span class="kw">Public</span> Nome <span class="kw">As</span> String
<span class="kw">Public</span> Email <span class="kw">As</span> String
<span class="kw">Public</span> Telefone <span class="kw">As</span> String

<span class="kw">Public Sub</span> ExibirDados()
    MsgBox Nome & vbCrLf & Email & vbCrLf & Telefone
<span class="kw">End Sub</span>

<span class="com">' --- Módulo padrão ---</span>
<span class="kw">Sub</span> TestarCliente()
    <span class="kw">Dim</span> c <span class="kw">As</span> clsCliente
    <span class="kw">Set</span> c = <span class="kw">New</span> clsCliente
    c.Nome = <span class="str">"João"</span>: c.Email = <span class="str">"joao@ex.com"</span>: c.Telefone = <span class="str">"999999999"</span>
    c.ExibirDados
<span class="kw">End Sub</span>`},
    {q:"Adicione validação à propriedade Email da classe clsCliente: só deve aceitar valores que contenham o caractere '@' (use Property Get/Let).",
     a:`<span class="kw">Private</span> mEmail <span class="kw">As</span> String

<span class="kw">Public Property Get</span> Email() <span class="kw">As</span> String
    Email = mEmail
<span class="kw">End Property</span>

<span class="kw">Public Property Let</span> Email(valor <span class="kw">As</span> String)
    <span class="kw">If</span> InStr(valor, <span class="str">"@"</span>) = 0 <span class="kw">Then</span>
        Err.Raise 5, , <span class="str">"E-mail inválido."</span>
    <span class="kw">Else</span>
        mEmail = valor
    <span class="kw">End If</span>
<span class="kw">End Property</span>`},
    {q:"Crie uma classe clsContaBancaria com propriedade Saldo (somente leitura externamente) e métodos Depositar e Sacar, impedindo saldo negativo.",
     a:`<span class="com">' --- clsContaBancaria ---</span>
<span class="kw">Private</span> mSaldo <span class="kw">As</span> Double

<span class="kw">Public Property Get</span> Saldo() <span class="kw">As</span> Double
    Saldo = mSaldo
<span class="kw">End Property</span>

<span class="kw">Public Sub</span> Depositar(valor <span class="kw">As</span> Double)
    mSaldo = mSaldo + valor
<span class="kw">End Sub</span>

<span class="kw">Public Sub</span> Sacar(valor <span class="kw">As</span> Double)
    <span class="kw">If</span> valor > mSaldo <span class="kw">Then</span>
        Err.Raise vbObjectError + 515, , <span class="str">"Saldo insuficiente."</span>
