    <span class="kw">For</span> i = 2 <span class="kw">To</span> UBound(dados, 1)
        <span class="kw">If</span> dados(i, 1) > maior <span class="kw">Then</span> maior = dados(i, 1)
    <span class="kw">Next</span> i
    MsgBox <span class="str">"Maior valor: "</span> & maior
<span class="kw">End Sub</span>`},
    {q:"Carregue o intervalo A1:B20 (colunas Preço e Quantidade) em um array 2D e escreva na coluna C o total de cada linha (Preço × Quantidade), tudo via array.",
     a:`<span class="kw">Sub</span> CalcularTotaisArray()
    <span class="kw">Dim</span> dados <span class="kw">As</span> Variant, resultado() <span class="kw">As</span> Double, i <span class="kw">As</span> Long
    dados = Range(<span class="str">"A1:B20"</span>).Value
    ReDim resultado(1 <span class="kw">To</span> UBound(dados, 1), 1 <span class="kw">To</span> 1)

    <span class="kw">For</span> i = 1 <span class="kw">To</span> UBound(dados, 1)
        resultado(i, 1) = dados(i, 1) * dados(i, 2)
    <span class="kw">Next</span> i
    Range(<span class="str">"C1:C20"</span>).Value = resultado
<span class="kw">End Sub</span>`},
    {q:"Percorra o intervalo A1:A100 e use ReDim Preserve para montar um array dinâmico contendo apenas os nomes não vazios encontrados.",
     a:`<span class="kw">Sub</span> ColetarNaoVazios()
    <span class="kw">Dim</span> nomes() <span class="kw">As</span> String, cont <span class="kw">As</span> Integer, i <span class="kw">As</span> Integer
    cont = 0
    <span class="kw">For</span> i = 1 <span class="kw">To</span> 100
        <span class="kw">If</span> Trim(Cells(i, 1).Value) <> <span class="str">""</span> <span class="kw">Then</span>
            cont = cont + 1
            ReDim <span class="kw">Preserve</span> nomes(1 <span class="kw">To</span> cont)
            nomes(cont) = Cells(i, 1).Value
        <span class="kw">End If</span>
    <span class="kw">Next</span> i
    MsgBox <span class="str">"Total de nomes coletados: "</span> & cont
<span class="kw">End Sub</span>`},
    {q:"Use a função Array() para criar uma lista com os nomes dos meses do ano e percorra-a exibindo cada um em uma MsgBox.",
     a:`<span class="kw">Sub</span> ListarMeses()
    <span class="kw">Dim</span> meses <span class="kw">As</span> Variant, i <span class="kw">As</span> Integer
    meses = Array(<span class="str">"Janeiro"</span>, <span class="str">"Fevereiro"</span>, <span class="str">"Março"</span>, <span class="str">"Abril"</span>, _
                   <span class="str">"Maio"</span>, <span class="str">"Junho"</span>, <span class="str">"Julho"</span>, <span class="str">"Agosto"</span>, _
                   <span class="str">"Setembro"</span>, <span class="str">"Outubro"</span>, <span class="str">"Novembro"</span>, <span class="str">"Dezembro"</span>)
    <span class="kw">For</span> i = 0 <span class="kw">To</span> UBound(meses)
        MsgBox meses(i)
    <span class="kw">Next</span> i
<span class="kw">End Sub</span>`},
    {q:"Escreva duas versões de uma mesma tarefa (multiplicar por 2 os valores de A1:A5000): uma célula a célula em loop e outra via array. Explique em comentário por que a segunda é muito mais rápida.",
     a:`<span class="com">' Versão lenta — célula a célula (acessa a planilha 5000 vezes)</span>
<span class="kw">Sub</span> DobrarLento()
    <span class="kw">Dim</span> i <span class="kw">As</span> Long
    <span class="kw">For</span> i = 1 <span class="kw">To</span> 5000
        Cells(i, 1).Value = Cells(i, 1).Value * 2
    <span class="kw">Next</span> i
<span class="kw">End Sub</span>

<span class="com">' Versão rápida — array (acessa a planilha apenas 2 vezes: leitura e escrita)</span>
<span class="kw">Sub</span> DobrarRapido()
    <span class="kw">Dim</span> dados <span class="kw">As</span> Variant, i <span class="kw">As</span> Long
    dados = Range(<span class="str">"A1:A5000"</span>).Value
    <span class="kw">For</span> i = 1 <span class="kw">To</span> UBound(dados, 1)
        dados(i, 1) = dados(i, 1) * 2
    <span class="kw">Next</span> i
    Range(<span class="str">"A1:A5000"</span>).Value = dados
<span class="kw">End Sub</span>
<span class="com">' A comunicação com a planilha (interop) é o gargalo; o array processa tudo em memória.</span>`}
  ]
},
{
