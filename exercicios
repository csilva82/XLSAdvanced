    {q:"Crie uma UDF ContarTexto(intervalo) que conte quantas células de um intervalo contêm texto (não números, não vazias).",
     a:`<span class="kw">Function</span> ContarTexto(intervalo <span class="kw">As</span> Range) <span class="kw">As</span> Long
    <span class="kw">Dim</span> cel <span class="kw">As</span> Range, cont <span class="kw">As</span> Long
    <span class="kw">For Each</span> cel <span class="kw">In</span> intervalo
        <span class="kw">If</span> Application.WorksheetFunction.IsText(cel) <span class="kw">Then</span> cont = cont + 1
    <span class="kw">Next</span> cel
    ContarTexto = cont
<span class="kw">End Function</span>`},
    {q:"Crie uma UDF AplicarDesconto(preco, Optional percentual = 5) que aplique um desconto padrão de 5% caso o percentual não seja informado.",
     a:`<span class="kw">Function</span> AplicarDesconto(preco <span class="kw">As</span> Double, _
        <span class="kw">Optional</span> percentual <span class="kw">As</span> Double = 5) <span class="kw">As</span> Double
    AplicarDesconto = preco * (1 - percentual / 100)
<span class="kw">End Function</span>`},
    {q:"Crie uma UDF SomaSeMaiorQue(intervalo, limite) que some apenas os valores de um intervalo que sejam maiores que um limite informado.",
     a:`<span class="kw">Function</span> SomaSeMaiorQue(intervalo <span class="kw">As</span> Range, limite <span class="kw">As</span> Double) <span class="kw">As</span> Double
    <span class="kw">Dim</span> cel <span class="kw">As</span> Range, soma <span class="kw">As</span> Double
    <span class="kw">For Each</span> cel <span class="kw">In</span> intervalo
        <span class="kw">If</span> cel.Value > limite <span class="kw">Then</span> soma = soma + cel.Value
    <span class="kw">Next</span> cel
    SomaSeMaiorQue = soma
<span class="kw">End Function</span>`},
    {q:"Crie uma UDF simplificada ValidarCPFFormato(cpf) que retorne True apenas se o texto informado tiver exatamente 11 caracteres numéricos (sem validar os dígitos verificadores).",
     a:`<span class="kw">Function</span> ValidarCPFFormato(cpf <span class="kw">As</span> String) <span class="kw">As</span> Boolean
    <span class="kw">Dim</span> i <span class="kw">As</span> Integer
