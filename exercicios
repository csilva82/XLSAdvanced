  exercises:[
    {q:"Adapte a consolidação de planilhas para ignorar qualquer planilha que esteja oculta (ws.Visible <> xlSheetVisible).",
     a:`<span class="kw">Sub</span> ConsolidarIgnorandoOcultas()
    <span class="kw">Dim</span> ws <span class="kw">As</span> Worksheet, wsDestino <span class="kw">As</span> Worksheet
    <span class="kw">Dim</span> ultOrigem <span class="kw">As</span> Long, ultDestino <span class="kw">As</span> Long
    <span class="kw">Set</span> wsDestino = Worksheets(<span class="str">"Consolidado"</span>)

    <span class="kw">For Each</span> ws <span class="kw">In</span> ThisWorkbook.Worksheets
        <span class="kw">If</span> ws.Name <> <span class="str">"Consolidado"</span> <span class="kw">And</span> ws.Visible = xlSheetVisible <span class="kw">Then</span>
            ultOrigem = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
            ultDestino = wsDestino.Cells(wsDestino.Rows.Count, 1).End(xlUp).Row + 1
            ws.Range(<span class="str">"A1:D"</span> & ultOrigem).Copy wsDestino.Cells(ultDestino, 1)
        <span class="kw">End If</span>
    <span class="kw">Next</span> ws
<span class="kw">End Sub</span>`},
    {q:"Consolide dados de várias pastas de trabalho de uma pasta, mas some os valores por categoria (coluna A) usando Scripting.Dictionary em vez de apenas empilhar as linhas.",
     a:`<span class="kw">Sub</span> ConsolidarSomandoPorCategoria()
    <span class="kw">Dim</span> dic <span class="kw">As</span> Object, pasta <span class="kw">As</span> String, arquivo <span class="kw">As</span> String
    <span class="kw">Dim</span> wb <span class="kw">As</span> Workbook, i <span class="kw">As</span> Long, ultLin <span class="kw">As</span> Long
    <span class="kw">Set</span> dic = CreateObject(<span class="str">"Scripting.Dictionary"</span>)
    pasta = <span class="str">"C:\\Relatorios\\"</span>
    arquivo = Dir(pasta & <span class="str">"*.xlsx"</span>)

    <span class="kw">Do While</span> arquivo <> <span class="str">""</span>
        <span class="kw">Set</span> wb = Workbooks.Open(pasta & arquivo)
        ultLin = wb.Worksheets(1).Cells(Rows.Count, 1).End(xlUp).Row
        <span class="kw">For</span> i = 2 <span class="kw">To</span> ultLin
            <span class="kw">Dim</span> chave <span class="kw">As</span> String: chave = wb.Worksheets(1).Cells(i, 1).Value
            <span class="kw">If</span> dic.Exists(chave) <span class="kw">Then</span>
                dic(chave) = dic(chave) + wb.Worksheets(1).Cells(i, 2).Value
            <span class="kw">Else</span>
                dic.Add chave, wb.Worksheets(1).Cells(i, 2).Value
            <span class="kw">End If</span>
        <span class="kw">Next</span> i
        wb.Close <span class="kw">False</span>
        arquivo = Dir
    <span class="kw">Loop</span>
<span class="kw">End Sub</span>`},
    {q:"Adapte a consolidação de planilhas para copiar apenas as linhas cuja coluna 'Status' (coluna D) esteja marcada como 'Aprovado'.",
     a:`<span class="kw">Sub</span> ConsolidarSomenteAprovados()
    <span class="kw">Dim</span> ws <span class="kw">As</span> Worksheet, wsDestino <span class="kw">As</span> Worksheet
    <span class="kw">Dim</span> i <span class="kw">As</span> Long, ultOrigem <span class="kw">As</span> Long, linDestino <span class="kw">As</span> Long
    <span class="kw">Set</span> wsDestino = Worksheets(<span class="str">"Consolidado"</span>)
    linDestino = wsDestino.Cells(wsDestino.Rows.Count, 1).End(xlUp).Row + 1

    <span class="kw">For Each</span> ws <span class="kw">In</span> ThisWorkbook.Worksheets
        <span class="kw">If</span> ws.Name <> <span class="str">"Consolidado"</span> <span class="kw">Then</span>
            ultOrigem = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
            <span class="kw">For</span> i = 2 <span class="kw">To</span> ultOrigem
                <span class="kw">If</span> ws.Cells(i, 4).Value = <span class="str">"Aprovado"</span> <span class="kw">Then</span>
                    ws.Range(<span class="str">"A"</span> & i & <span class="str">":D"</span> & i).Copy wsDestino.Cells(linDestino, 1)
                    linDestino = linDestino + 1
                <span class="kw">End If</span>
            <span class="kw">Next</span> i
        <span class="kw">End If</span>
    <span class="kw">Next</span> ws
<span class="kw">End Sub</span>`},
    {q:"Usando Dictionary, remova duplicidades da coluna A de uma planilha, escrevendo apenas os valores únicos na coluna F.",
     a:`<span class="kw">Sub</span> RemoverDuplicidades()
    <span class="kw">Dim</span> dic <span class="kw">As</span> Object, i <span class="kw">As</span> Long, ultLin <span class="kw">As</span> Long
    <span class="kw">Set</span> dic = CreateObject(<span class="str">"Scripting.Dictionary"</span>)
