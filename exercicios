    <span class="kw">Next</span> i

    <span class="kw">Dim</span> k <span class="kw">As</span> Variant, linha <span class="kw">As</span> Long: linha = 1
    <span class="kw">For Each</span> k <span class="kw">In</span> dic.Keys
